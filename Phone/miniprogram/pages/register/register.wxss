/**
 * register.wxss — 人脸采集注册页样式
 *
 * v0.3.0 新增：服务器状态栏、设置弹窗、连接测试
 *
 * 设计规范：
 *   - 间距步进：10rpx
 *   - 主色：#1677ff（品牌蓝）
 *   - 圆角：10rpx（卡片）/ 6rpx（按钮）
 *   - 阴影：轻微阴影提升层次感
 */

/* ========== 容器 & 头部 ========== */
.container {
  padding: 0 30rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
  margin-top: 30rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* ========== 服务器状态栏 ========== */
.server-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 0 0 12rpx 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin: 0 -30rpx 0;
}

.server-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.dot-configured {
  background-color: #52c41a;
  box-shadow: 0 0 6rpx rgba(82, 196, 26, 0.4);
}

.dot-default {
  background-color: #faad14;
  box-shadow: 0 0 6rpx rgba(250, 173, 20, 0.3);
}

.server-label {
  font-size: 22rpx;
  color: #999;
  margin-right: 10rpx;
}

.server-addr {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
}

.server-arrow {
  font-size: 22rpx;
  color: #1677ff;
  flex-shrink: 0;
}

/* ========== 照片区域 ========== */
.photo-area {
  position: relative;
  width: 100%;
  height: 500rpx;
  border: 4rpx dashed #d0d0d0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  margin-top: 20rpx;
  overflow: hidden;
  background: #fafafa;
  transition: border-color 0.2s ease;
}

.photo-area.has-photo {
  border-style: solid;
  border-color: #1677ff;
  background: #000;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.camera-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.placeholder-text {
  font-size: 28rpx;
  color: #bbb;
}

/* ========== 操作按钮 ========== */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn-row button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  padding: 0;
}

.btn-camera {
  color: #fff;
  background-color: #1677ff;
}

.btn-album {
  color: #1677ff;
  background-color: #e6f4ff;
  border: 2rpx solid #91caff;
}

.btn-hover {
  opacity: 0.8;
}

/* ========== 输入区域 ========== */
.input-section {
  margin-bottom: 40rpx;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.input-label {
  width: 100rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  flex-shrink: 0;
}

.name-input {
  flex: 1;
  height: 60rpx;
  font-size: 30rpx;
  color: #333;
}

.input-placeholder {
  color: #bfbfbf;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
  padding-right: 10rpx;
}

/* ========== 提交按钮 ========== */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  background-color: #1677ff;
  margin-bottom: 20rpx;
}

.submit-btn[disabled] {
  background-color: #d9d9d9;
  color: #fff;
}

/* ========== 提示文字 ========== */
.hint {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 0 40rpx;
  margin-bottom: 30rpx;
  line-height: 1.8;
}

/* ========== 结果区域 ========== */
.result-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 30rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  animation: fadeIn 0.3s ease;
}

.result-success {
  background-color: #f0fdf4;
  border: 2rpx solid #bbf7d0;
}

.result-error {
  background-color: #fef2f2;
  border: 2rpx solid #fecaca;
}

.result-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.result-success .result-message {
  color: #15803d;
}

.result-error .result-message {
  color: #b91c1c;
}

/* ========== 继续注册按钮 ========== */
.reset-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  color: #1677ff;
  background-color: #fff;
  border: 2rpx solid #1677ff;
}

/* ========== 设置弹窗 ========== */
.settings-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: overlayFadeIn 0.2s ease;
}

.settings-card {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: cardSlideUp 0.25s ease;
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.settings-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.settings-close {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-close text {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.settings-body {
  padding: 24rpx 30rpx 30rpx;
}

.settings-field {
  margin-bottom: 24rpx;
}

.settings-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.settings-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #f7f8fa;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.settings-input-placeholder {
  color: #bfbfbf;
}

.settings-hint {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

/* 连接测试结果 */
.test-result {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}

.test-ok {
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
}

.test-fail {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
}

.test-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.test-ok .test-icon {
  color: #16a34a;
}

.test-fail .test-icon {
  color: #dc2626;
}

.test-ok .test-message {
  color: #15803d;
}

.test-fail .test-message {
  color: #b91c1c;
}

/* 操作按钮 */
.settings-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.settings-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  text-align: center;
  padding: 0;
}

.save-btn {
  background: #1677ff;
  color: #fff;
  font-weight: 600;
}

.test-btn {
  background: #fff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
}

/* 扫码配置按钮 */
.scan-btn {
  background: #fff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
  font-size: 26rpx;
}

/* 最近使用服务器列表 */
.recent-section {
  margin-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.recent-title {
  font-size: 24rpx;
  color: #999;
}

.recent-clear {
  font-size: 22rpx;
  color: #ff4d4f;
  padding: 4rpx 8rpx;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 16rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.recent-url {
  font-size: 22rpx;
  color: #666;
  font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-delete {
  font-size: 28rpx;
  color: #ccc;
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* ========== 动画 ========== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes overlayFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes cardSlideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ========== 加载态按钮 ========== */
.btn-loading {
  opacity: 0.9;
}
