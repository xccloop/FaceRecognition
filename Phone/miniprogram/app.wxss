/**
 * 全局样式 — 人脸采集小程序
 *
 * 设计原则：
 *   - 移动端优先，使用 rpx 单位保证多设备适配
 *   - 颜色方案：简洁白底 + 品牌蓝主色调
 *   - 间距使用系统化步进（10rpx 倍数）
 */

/* ---- 基础重置 ---- */
page {
  height: 100%;
  overflow-y: auto;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #333333;
  background-color: #f5f5f5;
  line-height: 1.6;
}

/* ---- 通用工具类 ---- */
.text-center {
  text-align: center;
}

.text-muted {
  color: #999999;
}

.text-danger {
  color: #e74c3c;
}

.text-success {
  color: #27ae60;
}
