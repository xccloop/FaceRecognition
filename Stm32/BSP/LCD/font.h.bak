/* ════════════════════════════════════════════════════════════════
 *  中文 16x16 字库子集 (26 字符, 每个 32 字节)
 *
 *  格式: PCtoLCD2002 "逐列式" C51 格式
 *        byte[col*2]   = 第 col 列上半 (rows 0~7,  MSB=row0)
 *        byte[col*2+1] = 第 col 列下半 (rows 8~15, MSB=row8)
 *        前 16 字节 = 列 0~7,  后 16 字节 = 列 8~15
 *
 *  PCtoLCD2002 配置: 逐列式 / 顺向(高位在前) / C51格式 / 16×16
 *
 *  索引定义见下方 CN_CHAR_xxx 枚举
 *  取模后直接替换整个 cn16_font 数组即可
 * ════════════════════════════════════════════════════════════════ */

/* 中文字符索引 */
enum {
    CN_IDENTIFY = 0,   /* 识 */
    CN_DISTING,        /* 别 */
    CN_SUCCESS,        /* 成 */
    CN_MERIT,          /* 功 */
    CN_JOY,            /* 欢 */
    CN_WELCOME,        /* 迎 */
    CN_LOSE,           /* 失 */
    CN_DEFEAT,         /* 败 */
    CN_NOT,            /* 未 */
    CN_REGISTER,       /* 注 */
    CN_BOOK,           /* 册 */
    CN_MANY,           /* 多 */
    CN_PERSON,         /* 人 */
    CN_FACE,           /* 脸 */
    CN_NONE,           /* 无 */
    CN_WAIT,           /* 待 */
    CN_MACHINE,        /* 机 */
    CN_MIDDLE,         /* 中 */
    CN_SYSTEM,         /* 系 */
    CN_READY,          /* 统 */
    CN_JUST,           /* 就 */
    CN_THREAD,         /* 绪 */
    CN_ERROR,          /* 错 */
    CN_MISTAKE,        /* 误 */
    CN_SAFE,           /* 安 */
    CN_ALL,            /* 全 */
    CN_COUNT
};

/* 16x16 中文位图 — PCtoLCD2002 逐列式 C51 格式 */
static const uint8_t cn16_font[CN_COUNT][32] = {
    /* [0] 识 */
