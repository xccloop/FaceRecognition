/* ================================================================
 *  font.h — 字库数据 (ASCII 8x16 + 中文 16x16 子集)
 *
 *  ASCII 字库: asc2_1608[95][16], 来自 ALIENTEK 标准例程
 *  中文子集: cn16_font, 仅包含本项目需要的 ~20 个汉字
 *
 *  位图格式: 列优先 (column-major), MSB=像素顶部
 *  ASCII: 8 列 × 16 行 = 16 字节/字
 *  中文:  16 列 × 16 行 = 32 字节/字 (左8列 + 右8列)
 *
 *  如需扩展中文, 使用 PCtoLCD2002 生成, 格式同上
 * ================================================================ */

#ifndef FONT_H
#define FONT_H

